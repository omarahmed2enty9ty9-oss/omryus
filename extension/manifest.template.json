{
  "manifest_version": 3,
  "name": "Omryus — partner discount codes",
  "version": "0.1.0",
  "description": "Shows partner discount codes on stores we support, and inserts one only when you click Apply.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": "GENERATED_FROM_OFFERS_JSON",
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_page": "options/options.html"
}
