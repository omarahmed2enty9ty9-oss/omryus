# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Awin (publisher) ---
# Awin UI → account → API credentials. The publisher ID is in the URL and in
# every clickThroughUrl the API returns (…awclick.php?mid=<advertiser>&id=<you>).
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# --- impact.com (media partner) ---
# Impact uses HTTP basic auth: account SID as the username, auth token as the
# password. Both are under Settings → API in the Impact UI.
IMPACT_AUTH_TOKEN=
IMPACT_ACCOUNT_SID=
